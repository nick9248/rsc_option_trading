# Copy this file to .env and fill in your values. Only DB_PASSWORD is required.

# Database (defaults: localhost, 5433, option_trading, postgres)
DB_PASSWORD=your_password_here
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=option_trading
# DB_USER=postgres

# Read-only Deribit API key for the account collector. Without it the account tables stay empty.
# client_id=
# deribit_key=

# Telegram bot of the MenthorQ monitor. Without them no Telegram messages are sent.
# OSF_TELEGRAM_BOT_TOKEN=
# OSF_TELEGRAM_CHAT_ID=

# MenthorQ-style level monitor in the collector (all optional; defaults shown).
# The /brief command is accepted only from OSF_TELEGRAM_CHAT_ID.
# The monitor, its Telegram alerts/weekly brief and its bot commands are all OFF by
# default. Set all three to 1 ONLY in the production (VPS) .env: locally the monitor
# would write rows into the mirror that sync_from_vps.py fills, and a second process
# polling the same bot steals its updates (409 conflicts) and sends duplicate alerts.
# The dry run (scripts.menthorq_brief) and the GUI preview work without them.
# MENTHORQ_MONITOR_ENABLED=0
# MENTHORQ_ALERTS_ENABLED=0
# MENTHORQ_COMMANDS_ENABLED=0
# MENTHORQ_EXPIRY_UNIVERSE=monthly
# MENTHORQ_LIVE_RUN_MINUTE=10
# MENTHORQ_WEEKLY_BRIEF_DAY=fri
# MENTHORQ_WEEKLY_BRIEF_TIME_UTC=09:00
# MENTHORQ_COMMAND_POLL_SECONDS=20
